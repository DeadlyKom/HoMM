
                ifndef _DRAW_BOUNDARY_SPRITE_NOT_CLIPPING_MACRO_
                define _DRAW_BOUNDARY_SPRITE_NOT_CLIPPING_MACRO_
; -----------------------------------------
; восстановление адреса экрана
; In:
;   SP - адрес спрайта
;   HL - адрес знакоместа атрибутов
;   DE - адрес экрана
;   BC - два байта спрайта
; Out:
;   HL - адрес экрана
;   D  - старший адрес таблицы зеркальных байт
; Corrupt:
;   DE
; Note:
;   отображение производится вверху вниз
; -----------------------------------------
RESTORE_SCR_ADR macro
                EX DE, HL
                LD D, HIGH Adr.ByteMirrorTable                                  ; адреса таблицы зеркальных байт/буфера
                endm
; -----------------------------------------
; установка атрибута
; In:
;   SP - адрес спрайта
;   HL - адрес атрибутов
;   DE - адрес экрана
;   BC - два байта спрайта
; Out:
; Corrupt:
; Note:
; -----------------------------------------
SET_ATTR        macro
                ; -----------------------------------------
                ; флаги в регистре B
                ;
                ;      7    6    5    4    3    2    1    0
                ;   +----+----+----+----+----+----+----+----+
                ;   | .. | .. | .. | .. | .. | SA | LS | NV |
                ;   +----+----+----+----+----+----+----+----+
                ;
                ;   SA      [2]     - флаг, пропуска записи атрибута
                ;                       0 - записать атрибут спрайта
                ;                       1 - сохранить атрибут экрана
                ;   LS      [1]     - флаг, последнего знакоместа спрайта
                ;                       0 - вывод спрайта не завершён
                ;                       1 - завершить вывод спрайта
                ;   NV      [0]     - флаг, продолжения вывода по вертикали
                ;                       0 - текущий столбец завершён
                ;                       1 - продолжить текущий столбец
                ; -----------------------------------------

                ; проверка пропуска записи атрибута знакоместа
                BIT SPRITE_BOUNDARY_SKIP_ATTR_BIT, B
                JR NZ, $+3                                                      ; переход, если атрибут экрана нужно сохранить
                LD (HL), C                                                      ; запись атрибута спрайта

                LD A, B                                                         ; сохранение флагов текущего знакоместа
                POP BC                                                          ; чтение следующей пары данных спрайта
                endm

                endif ; ~ _DRAW_BOUNDARY_SPRITE_NOT_CLIPPING_MACRO_
