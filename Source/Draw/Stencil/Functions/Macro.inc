
                ifndef _DRAW_STENCIL_FUNCTIONS_MACRO_
                define _DRAW_STENCIL_FUNCTIONS_MACRO_
; -----------------------------------------
; применение трафарета
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
APPLY_STENCIL   macro
                EX DE, HL
                XOR (HL)    ; выделение отличий от исходного экрана
                AND (IX + 0); применение трафарета
                INC IX      ; следующий байт трафарета
                XOR (HL)    ; восстановление пикселей вне трафарета
                LD (HL), A  ; запись байта в экран
                INC L       ; переход к следующему знакоместу
                EX DE, HL
                endm
; -----------------------------------------
; применение трафарета - завершающий (нет перехода к следующему знакоместу)
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
APPLY_STENCIL_  macro
                EX DE, HL
                XOR (HL)    ; выделение отличий от исходного экрана
                AND (IX + 0); применение трафарета
                INC IX      ; следующий байт трафарета
                XOR (HL)    ; восстановление пикселей вне трафарета
                LD (HL), A  ; запись байта в экран
                EX DE, HL
                endm
; -----------------------------------------
; применеие OR & XOR (хвост)
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
S_OR_XOR_TAIL   macro
                LD A, (DE)  ; чтение байта из экрана
                INC H       ; второй байт таблицы смещения (хвост)
                LD L, C
                OR (HL)     ; применение смещённой OR-маски
                LD L, B
                XOR (HL)    ; применение смещённых XOR-данных
                DEC H       ; первый байт таблицы смещения (начало)
                endm
; -----------------------------------------
; применеие OR & XOR - завершающий (хвост)
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
S_OR_XOR_TAIL_  macro
                LD A, (DE)  ; чтение байта из экрана
                INC H       ; второй байт таблицы смещения (хвост)
                LD L, C
                OR (HL)     ; применение смещённой OR-маски
                LD L, B
                XOR (HL)    ; применение смещённых XOR-данных
                DEC H       ; первый байт таблицы смещения (начало)
                endm
; -----------------------------------------
; применеие OR & XOR (начало)
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
S_OR_XOR_HEAD   macro
                POP BC      ; чтение OR & XOR
                LD L, C
                OR (HL)     ; применение смещённой OR-маски
                LD L, B
                XOR (HL)    ; применение смещённых XOR-данных
                endm
; -----------------------------------------
; применеие OR & XOR - начинающий (начало)
; In:
;   SP - адрес спрайта
;   H  - старший байт адреса таблицы сдвига
;   DE - адрес экрана (текущий)
;   BC - пара данных спрайта OR & XOR
;   IX - адрес трафарета (текущий)
; Out:
; Corrupt:
; Note:
; -----------------------------------------
S_OR_XOR_HEAD_  macro
                LD A, (DE)  ; чтение байта из экрана
                LD L, C
                OR (HL)     ; применение смещённой OR-маски
                LD L, B
                XOR (HL)    ; применение смещённых XOR-данных
                endm
; -----------------------------------------
; применение OR & XOR без смещения (начало)
; In:
;   SP - адрес следующей пары данных спрайта
;   DE - адрес экрана (текущий)
;   BC - начальная пара данных спрайта (B - XOR, C - OR)
; Out:
;   A  - результат применения OR & XOR
; Corrupt:
;   AF
; Note:
;   OR-данные в C хранятся без зеркального отражения
; -----------------------------------------
NS_OR_XOR_HEAD  macro
                LD A, (DE)                                                      ; чтение байта из экрана
                OR C                                                            ; применение OR-данных
                XOR B                                                           ; применение XOR-данных
                endm
; -----------------------------------------
; применение OR & XOR без смещения (хвост)
; In:
;   SP - адрес завершающей пары данных спрайта
;   DE - адрес экрана (текущий)
; Out:
;   A  - результат применения OR & XOR
; Corrupt:
;   BC, AF, SP
; Note:
;   OR-данные в C хранятся без зеркального отражения
; -----------------------------------------
NS_OR_XOR_TAIL  macro
                POP BC                                                          ; чтение завершающей пары OR & XOR
                LD A, (DE)                                                      ; чтение байта из экрана
                OR C                                                            ; применение OR-данных
                XOR B                                                           ; применение XOR-данных
                endm

                endif ; ~ _DRAW_STENCIL_FUNCTIONS_MACRO_
