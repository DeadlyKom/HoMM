                ifndef _DRAW_SPRITE_CONTOUR_MACROS_
                define _DRAW_SPRITE_CONTOUR_MACROS_
; -----------------------------------------
; чтение следующего OR-байта спрайта
; In:
;   HL - адрес текущей пары OR/XOR
; Out:
;   HL - адрес следующей пары OR/XOR
;   E  - OR-байт спрайта
; Corrupt:
;   F
; -----------------------------------------
CONTOUR_H_NEXT  macro
                INC L
                INC L
                LD E, (HL)
                endm
; -----------------------------------------
; чтение маски из таблицы в регистр
; In:
;   DE - адрес элемента таблицы
;   Register? - регистр результата
; Out:
;   Register? - маска из таблицы
; Corrupt:
;   A
; -----------------------------------------
CONTOUR_H_LOAD  macro Register?
                LD A, (DE)
                LD Register?, A
                endm
; -----------------------------------------
; запись байта внешней маски
; In:
;   DE - адрес байта внешней маски
;   A  - маска
; Out:
; Corrupt:
;   E, F
; -----------------------------------------
CONTOUR_H_STORE macro
                LD (DE), A
                INC E
                endm
; -----------------------------------------
; запись байта внешней маски через альтернативный указатель
; In:
;   A   - маска
;   DE' - адрес байта внешней маски
; Out:
; Corrupt:
;   F, E'
; -----------------------------------------
CONTOUR_H_STORE_ALT macro
                EXX
                LD (DE), A
                INC E
                EXX
                endm
; -----------------------------------------
; объединение и запись байта внутренней маски
; In:
;   DE - адрес элемента таблицы
;   IY - адрес рабочего буфера + 64
;   Register? - накопленная маска
;   Offset? - смещение байта внутренней маски
; Out:
; Corrupt:
;   AF
; -----------------------------------------
CONTOUR_H_MERGE_IN macro Register?, Offset?
                LD A, (DE)
                OR Register?
                LD (IY + Offset?), A
                endm
; -----------------------------------------
; объединение и запись байта внешней маски
; In:
;   DE - адрес элемента таблицы
;   Register? - накопленная маска
;   DE' - адрес байта внешней маски
; Out:
; Corrupt:
;   AF, E'
; -----------------------------------------
CONTOUR_H_MERGE_OUT macro Register?
                LD A, (DE)
                OR Register?
                EXX
                LD (DE), A
                INC E
                EXX
                endm
; -----------------------------------------
; объединение допустимого вертикального окна
; In:
;   HL  - первый байт допустимого вертикального окна
;   DE  - размер спрайта по горизонтали в знакоместах
;   A   - начальное объединение строк
; Out:
;   A   - объединение вертикального окна
; Corrupt:
;   HL, AF
; Note:
; -----------------------------------------
CONTOUR_V_SCAN  macro
                dup 6
                OR (HL)
                ADD HL, DE
                edup
                OR (HL)
                endm

                endif ; ~ _DRAW_SPRITE_CONTOUR_MACROS_
