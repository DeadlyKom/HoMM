
                    ifndef _INPUT_KEMPSTON_VIRTUAL_KEYS_
                    define _INPUT_KEMPSTON_VIRTUAL_KEYS_
; -----------------------------------------
;   признак виртуальных клавиш Kempston
; -----------------------------------------

; сдвиг на 3 бита
VK_KEMPSTON_RIGHT   EQU KEMPSTON_JOYSTICK | (0x00 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_LEFT    EQU KEMPSTON_JOYSTICK | (0x01 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_DOWN    EQU KEMPSTON_JOYSTICK | (0x02 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_UP      EQU KEMPSTON_JOYSTICK | (0x03 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_B       EQU KEMPSTON_JOYSTICK | (0x04 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_C       EQU KEMPSTON_JOYSTICK | (0x05 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_A       EQU KEMPSTON_JOYSTICK | (0x06 << KEMPSTON_JOYSTICK_SHIFT)
VK_KEMPSTON_START   EQU KEMPSTON_JOYSTICK | (0x07 << KEMPSTON_JOYSTICK_SHIFT)

; ToDo: возможные будущее расширения Kempstom-джойстика (объявления, не используются)
VK_KEMPSTON_X       EQU KEMPSTON_JOYSTICK | 0x08
VK_KEMPSTON_Y       EQU KEMPSTON_JOYSTICK | 0x09
VK_KEMPSTON_Z       EQU KEMPSTON_JOYSTICK | 0x0A
VK_KEMPSTON_MODE    EQU KEMPSTON_JOYSTICK | 0x0B

                    endif ; ~_INPUT_KEMPSTON_VIRTUAL_KEYS_
