
                ifndef _PLAYER_MUSIC_AY_STRUCTS_
                define _PLAYER_MUSIC_AY_STRUCTS_
; -----------------------------------------
; формат модуля PT3, смещения в байтах от начала модуля
;   #00–#62 - текстовый заголовок, #0D содержит цифру версии
;   #63     - номер таблицы периодов нот
;   #64     - начальное число тиков между строками паттерна
;   #65     - число позиций, проигрыватель ищет конец списка по байту #FF
;   #66     - индекс позиции зацикливания от начала списка
;   #67–#68 - смещение таблицы потоков паттернов
;   #69–#A8 - 32 смещения сэмплов
;   #A9–#C8 - 16 смещений орнаментов
;   #C9     - начало списка позиций, #FF завершает список
;
;   Смещения в таблицах записаны младшим байтом вперёд.
;   Позиция содержит индекс слова в таблице потоков. С этого слова
;   последовательно читаются смещения потоков каналов A, B и C.
;   PositionPtr при запуске указывает на байт перед первой позицией.
; -----------------------------------------
                struct FPT3Header                                               ; заголовок модуля до списка позиций [201 байт]
Signature       DS PT3_VERSION_OFFSET, #00                                      ; текст перед цифрой версии
VersionDigit    DB #00                                                          ; ASCII-цифра версии проигрывания
ModuleText      DS PT3_HEADER_TEXT_BYTES - PT3_VERSION_OFFSET - 1, #00          ; остаток текстового заголовка
NoteTable       DB #00                                                          ; номер таблицы периодов нот
Delay           DB #00                                                          ; начальное число тиков между строками
PositionCount   DB #00                                                          ; число позиций в модуле
LoopPosition    DB #00                                                          ; индекс позиции зацикливания
PatternOffset   FAddress                                                        ; смещение таблицы потоков от начала модуля
SampleOffsets   DS PT3_SAMPLE_COUNT * FAddress, #00                             ; таблица смещений сэмплов
OrnamentOffsets DS PT3_ORNAMENT_COUNT * FAddress, #00                           ; таблица смещений орнаментов
                ends

; состояние одного канала PT3
                struct FPT3Channel                                              ; состояние канала PT3 [29 байт]
; поля от начала канала, которые сбрасываются при новой ноте или её выключении
OrnamentPos     DB #00                                                          ; позиция в орнаменте
SamplePos       DB #00                                                          ; позиция в сэмпле
VolumeAdjust    DB #00                                                          ; накопленная поправка громкости
NoiseAdjust     DB #00                                                          ; накопленная поправка периода шума
EnvelopeAdjust  DB #00                                                          ; накопленная поправка периода огибающей
ToneSlideTicks  DB #00                                                          ; счётчик тиков до следующего шага скольжения тона
ToneSlide       DW #0000                                                        ; текущая поправка периода тона от скольжения
ToneAdjust      DW #0000                                                        ; накопленная поправка периода тона из сэмпла
GateTicks       DB #00                                                          ; счётчик тиков до включения или выключения канала
GateOnDelay     DB #00                                                          ; длительность включённого состояния канала в тиках

; опорное поле декодера паттерна, смещение от начала канала равно 12
GateOffDelay    DB #00                                                          ; длительность выключенного состояния канала в тиках
OrnamentPtr     FAddress                                                        ; адрес орнамента
SamplePtr       FAddress                                                        ; адрес сэмпла
RowDelay        DB #00                                                          ; число строк между командами канала
Note            DB #00                                                          ; номер текущей ноты от 0 до 95
TargetNote      DB #00                                                          ; номер целевой ноты портаменто
EnvelopeMask    DB #00                                                          ; маска включения огибающей в регистре громкости AY
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | GL | .. | EN |
;   +----+----+----+----+----+----+----+----+
;
;   GL      [2]     - флаг, глиссандо без целевой ноты
;                       0 - портаменто при включённом скольжении
;                       1 - скольжение без остановки на целевой ноте
;   EN      [0]     - флаг, звучание ноты канала
;                       0 - нота выключена
;                       1 - нота включена
; -----------------------------------------
Flags           DB #00                                                          ; флаги состояния канала
ToneSlideDelay  DB #00                                                          ; интервал между шагами скольжения тона в тиках
ToneSlideStep   DW #0000                                                        ; знаковый шаг изменения периода тона
TargetToneDelta DW #0000                                                        ; разность периодов целевой и исходной нот портаменто
RowTicks        DB #00                                                          ; счётчик строк до чтения следующей команды канала
Volume          DB #00                                                          ; громкость канала в старших четырёх битах
                ends

                endif ; ~ _PLAYER_MUSIC_AY_STRUCTS_
