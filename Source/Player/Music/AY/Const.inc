
                ifndef _PLAYER_MUSIC_AY_CONST_
                define _PLAYER_MUSIC_AY_CONST_

Release                 EQU "7"
TonA                    EQU 0                                                   ; период тона канала A
TonB                    EQU 2                                                   ; период тона канала B
TonC                    EQU 4                                                   ; период тона канала C
Noise                   EQU 6                                                   ; период шума
Mixer                   EQU 7                                                   ; микшер
AmplA                   EQU 8                                                   ; громкость канала A
AmplB                   EQU 9                                                   ; громкость канала B
AmplC                   EQU 10                                                  ; громкость канала C
Env                     EQU 11                                                  ; период огибающей
EnvTp                   EQU 13                                                  ; форма огибающей

; -----------------------------------------
; настройки проигрывателя, байт Setup
; -----------------------------------------
PT3_FINISHED_BIT        EQU 7                                                   ; флаг, достигнут конец списка позиций
PT3_NO_LOOP_BIT         EQU 0                                                   ; флаг, остановка в конце списка позиций, при нуле повтор с позиции зацикливания

; -----------------------------------------
; состояние канала, поле FPT3Channel.Flags
; -----------------------------------------
PT3_NOTE_ON_BIT         EQU 0                                                   ; флаг, нота канала включена
PT3_GLISSANDO_BIT       EQU 2                                                   ; флаг, скольжение тона без целевой ноты, при нуле активное скольжение работает как портаменто

; -----------------------------------------
; первый управляющий байт строки сэмпла
; -----------------------------------------
PT3_SAMPLE_VOL_ADJ_BIT  EQU 7                                                   ; флаг, изменение накопленной поправки громкости
PT3_SAMPLE_VOL_UP_BIT   EQU 6                                                   ; флаг, увеличение поправки громкости, при нуле уменьшение
PT3_SAMPLE_NO_ENV_BIT   EQU 0                                                   ; флаг, запрет огибающей в этой строке сэмпла

; -----------------------------------------
; второй управляющий байт строки сэмпла
; -----------------------------------------
PT3_SAMPLE_TONE_ACC_BIT EQU 6                                                   ; флаг, сохранение поправки периода тона для следующих строк
PT3_SAMPLE_MOD_ACC_BIT  EQU 5                                                   ; флаг, сохранение поправки шума или огибающей для следующих строк
PT3_SAMPLE_ENV_BIT      EQU 7                                                   ; флаг, отключение шума и выбор поправки огибающей, при нуле поправка применяется к шуму

; -----------------------------------------
; границы команд потока паттерна
;   #00–#0F - дополнительные команды из Effects.EffectTable
; -----------------------------------------
PT3_CMD_ENV_SAMPLE      EQU #10                                                 ; #10–#1F задают огибающую и сэмпл, #10 выключает огибающую
PT3_CMD_NOISE           EQU #20                                                 ; #20–#3F задают базовый период шума 0–31
PT3_CMD_ORNAMENT        EQU #40                                                 ; #40–#4F выбирают орнамент 0–15
PT3_CMD_NOTE            EQU #50                                                 ; #50–#AF включают ноту 0–95 и сбрасывают её состояние
PT3_CMD_ENV_OFF         EQU #B0                                                 ; выключение огибающей и возврат к началу орнамента
PT3_CMD_ROW_DELAY       EQU #B1                                                 ; чтение интервала строк, #B2–#BF задают огибающую
PT3_CMD_NOTE_OFF        EQU #C0                                                 ; выключение ноты, #C1–#CF задают громкость
PT3_CMD_END_ROW         EQU #D0                                                 ; конец строки, #D1–#EF выбирают сэмпл
PT3_CMD_ORN_SAMPLE      EQU #F0                                                 ; #F0–#FF выбирают орнамент 0–15 и сэмпл

; -----------------------------------------
; шаги декодера между соседними группами команд
; -----------------------------------------
PT3_CMD_STEP_16         EQU #100 - PT3_CMD_ORN_SAMPLE
PT3_CMD_STEP_32         EQU PT3_CMD_ORN_SAMPLE - PT3_CMD_END_ROW
PT3_CMD_NOTE_COUNT      EQU PT3_CMD_ENV_OFF - PT3_CMD_NOTE
PT3_CMD_STEPS           EQU (PT3_CMD_STEP_32 << 8) | PT3_CMD_STEP_16
PT3_EFFECT_INDEX_BIAS   EQU (PT3_CMD_STEP_32 << 8) + #100 - 2 * PT3_CMD_ENV_SAMPLE

; -----------------------------------------
; начальные значения соседних полей FPT3Channel.RowTicks и Volume
; -----------------------------------------
PT3_INIT_VOLUME         EQU #0F                                                 ; начальная громкость канала
PT3_INIT_ROW_TICKS      EQU #01                                                 ; чтение команды канала при обработке первой строки
; громкость занимает старшие четыре бита поля Volume, поле Volume хранится в старшем байте слова
PT3_INIT_ROW_VOLUME     EQU ((PT3_INIT_VOLUME << 4) << 8) | PT3_INIT_ROW_TICKS

; -----------------------------------------
; совместимость эффектов между версиями PT3
; -----------------------------------------
PT3_DEFAULT_VERSION     EQU 6                                                   ; версия PT3.6 при отсутствии цифры версии в заголовке
PT3_PORTAMENTO_MIN_VER  EQU 6                                                   ; с PT3.6 портаменто восстанавливает поправку тона предыдущей ноты
PT3_GLISS_ZERO_MIN_VER  EQU 7                                                   ; с PT3.7 глиссандо с нулевой задержкой начинает отсчёт с одного тика

; -----------------------------------------
; формат таблицы PackedPeriods
; -----------------------------------------
PT3_PERIOD_SIZE         EQU 2                                                   ; размер распакованного периода в байтах
PT3_PACKED_COUNT        EQU 49                                                  ; число периодов в четырёх группах, 12 + 13 + 12 + 12
PT3_PACKED_DELTA_MIN    EQU #1E                                                 ; байт ниже #1E начинает двухбайтовый период, остальные байты задают приращение
PT3_PACKED_LAST_PERIOD  EQU #1DF0                                               ; последний удвоенный период, распаковщик проверяет его младший байт

; -----------------------------------------
; геометрия таблицы периодов нот
; -----------------------------------------
PT3_NOTES_PER_OCTAVE    EQU 12                                                  ; число нот в октаве
PT3_OCTAVE_COUNT        EQU 8                                                   ; число октав в таблице периодов
PT3_NOTE_LAST           EQU PT3_CMD_NOTE_COUNT - 1                              ; последний допустимый номер ноты
PT3_OCTAVE_BYTES        EQU PT3_NOTES_PER_OCTAVE * PT3_PERIOD_SIZE              ; размер одной октавы в таблице периодов
PT3_NOTE_TABLE_BYTES    EQU PT3_CMD_NOTE_COUNT * PT3_PERIOD_SIZE                ; размер таблицы периодов нот в байтах
PT3_NOTE_FIX_OFFSET     EQU #2E                                                 ; смещение младшего байта периода ноты 23 для старой таблицы 1
PT3_NOTE_FIX_LOW        EQU #FD                                                 ; исправленный младший байт периода ноты 23 для старой таблицы 1

; -----------------------------------------
; громкость и размещение рабочих данных
; -----------------------------------------
PT3_VOLUME_LEVELS       EQU #10                                                 ; число уровней громкости, старшие четыре бита индекса задаёт канал, младшие четыре задаёт сэмпл
PT3_VOLUME_MAX          EQU #0F                                                 ; максимальная громкость и маска младших четырёх битов индекса
PT3_VOLUME_TABLE_SIZE   EQU PT3_VOLUME_LEVELS * PT3_VOLUME_LEVELS               ; размер таблицы сочетаний громкости канала и сэмпла в байтах
PT3_AY_REG_COUNT        EQU EnvTp + 1                                           ; число байтов в буфере регистров R0–R13
PT3_VOLUME_STEP_INIT    EQU #11                                                 ; начальное значение шага для таблицы PT3.5 и новее, старый вариант уменьшает его до #10
PT3_VOLUME_STEP_FIX     EQU #77                                                 ; значение младшего байта шага, при котором добавляется единица

; -----------------------------------------
; версия модуля и подменяемые операции округления
; -----------------------------------------
PT3_ASCII_ZERO          EQU #30                                                 ; код ASCII-цифры 0 в заголовке модуля
PT3_VERSION_DIGITS      EQU 10                                                  ; число допустимых десятичных цифр версии
PT3_NOTE_TABLE_MIN_VER  EQU 4                                                   ; с этой цифры версии выбирается новый вариант таблицы нот
PT3_VOLUME_MIN_VER      EQU 5                                                   ; с этой цифры версии используется новый расчёт таблицы громкости
PT3_NOTE_TABLE_MASK     EQU #07                                                 ; маска индекса, два бита номера таблицы и один бит варианта
PT3_OP_AND_A            EQU #A7                                                 ; код AND A для отключения округления периода по переносу
PT3_OP_RLA              EQU #17                                                 ; код RLA для округления громкости по старшему биту дробной части

; -----------------------------------------
; флаги микшера из строки сэмпла
; -----------------------------------------
PT3_SAMPLE_NO_TONE_BIT  EQU 4                                                   ; флаг, отключение тона во втором управляющем байте сэмпла
; маска отключения шума и тона после сдвига управляющего байта вправо
PT3_SAMPLE_MIX_MASK     EQU (1 << (PT3_SAMPLE_ENV_BIT - 1)) | (1 << (PT3_SAMPLE_NO_TONE_BIT - 1))

; -----------------------------------------
; размеры полей заголовка PT3
; -----------------------------------------
PT3_VERSION_OFFSET      EQU #0D                                                 ; смещение ASCII-цифры версии в текстовом заголовке
PT3_HEADER_TEXT_BYTES   EQU #63                                                 ; размер текстового заголовка до номера таблицы периодов
PT3_SAMPLE_COUNT        EQU 32                                                  ; число записей таблицы смещений сэмплов
PT3_ORNAMENT_COUNT      EQU 16                                                  ; число записей таблицы смещений орнаментов

                endif ; ~ _PLAYER_MUSIC_AY_CONST_
