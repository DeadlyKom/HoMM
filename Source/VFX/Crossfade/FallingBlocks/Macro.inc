
                ifndef _VFX_CROSSFADE_FALLING_BLOCKS_MACRO_
                define _VFX_CROSSFADE_FALLING_BLOCKS_MACRO_
; -----------------------------------------
; копирование строки шириной 16 пикселей в буфер
; In:
;   HL - адрес левого байта строки исходного блока
;   DE - адрес записи в буфере
; Out:
;   HL - исходный адрес левого байта строки
;   DE - адрес следующей пары байтов в буфере
; Corrupt:
;   BC, AF
; Note:
;   сначала копируется левый байт, затем правый
; -----------------------------------------
FB_COPY_ROW     macro
                LDI
                LD A, (HL)
                LD (DE), A
                INC DE
                DEC L
                endm
; -----------------------------------------
; преобразование пиксельного адреса в атрибутный
; In:
;   HL - адрес пикселей основного или теневого экрана
; Out:
;   HL - адрес соответствующего знакоместа атрибутов
; Corrupt:
;   AF
; Note:
;   используется подготовленная таблица Adr.ScrAttrAdrTable
; -----------------------------------------
FB_TO_ATTR      macro
                LD A, L
                LD L, H
                LD H, HIGH Adr.ScrAttrAdrTable                                  ; таблица преобразования старшего байта адреса
                LD H, (HL)
                LD L, A
                endm

; -----------------------------------------
; копирование строки слева направо с переходом вниз
; In:
;   HL - адрес левого байта строки теневого экрана
;   DE - адрес левого байта строки основного экрана
; Out:
;   HL - адрес правого байта следующей строки источника
;   DE - адрес правого байта следующей строки назначения
; Corrupt:
;   BC, AF
; -----------------------------------------
FB_RESTORE_ROW  macro
                LDI
                LD A, (HL)
                LD (DE), A
                INC H
                INC D
                endm
; -----------------------------------------
; копирование строки справа налево с переходом вниз
; In:
;   HL - адрес правого байта строки теневого экрана
;   DE - адрес правого байта строки основного экрана
; Out:
;   HL - адрес левого байта следующей строки источника
;   DE - адрес левого байта следующей строки назначения
; Corrupt:
;   BC, AF
; -----------------------------------------
FB_RESTORE_ROW_R macro
                LDD
                LD A, (HL)
                LD (DE), A
                INC H
                INC D
                endm
; -----------------------------------------
; копирование последней строки справа налево
; In:
;   HL - адрес правого байта строки теневого экрана
;   DE - адрес правого байта строки основного экрана
; Out:
;   HL - адрес левого байта текущей строки источника
;   DE - адрес левого байта текущей строки назначения
; Corrupt:
;   BC, AF
; -----------------------------------------
FB_RESTORE_ROW_R_ macro
                LDD
                LD A, (HL)
                LD (DE), A
                endm
; -----------------------------------------
; восстановление половины блока 16x8 с атрибутами
; In:
;   HL - адрес первой строки половины в теневом экране
;   DE - адрес первой строки половины в основном экране
; Out:
; Corrupt:
;   HL, DE, BC, AF
; Note:
;   границы экрана и трафарет проверяются перед вызовом
; -----------------------------------------
FB_RESTORE_HALF macro
                ; копирование восьми пиксельных строк змейкой
                FB_RESTORE_ROW
                FB_RESTORE_ROW_R
                FB_RESTORE_ROW
                FB_RESTORE_ROW_R
                FB_RESTORE_ROW
                FB_RESTORE_ROW_R
                FB_RESTORE_ROW
                FB_RESTORE_ROW_R_

                ; преобразование адреса источника в атрибутный
                FB_TO_ATTR

                ; подготовка адреса атрибутов основного экрана
                LD D, H
                RES 7, D
                LD E, L

                ; копирование двух атрибутов половины
                LDI
                LDI
                endm
; -----------------------------------------
; рисование двух строк шириной 16 пикселей
; In:
;   HL - адрес левого байта первой строки
;   BC - пиксели первой строки, C = левый байт, B = правый
;   SP - адрес следующей пары байтов в буфере
;   Direction? - INC для движения вниз, DEC для движения вверх
; Out:
;   HL - адрес левого байта следующей строки
;   BC - пиксели следующей строки
; Corrupt:
;   AF
; -----------------------------------------
FB_DRAW_PAIR    macro Direction?
                ; вывод первой строки слева направо
                LD (HL), C
                INC L
                LD (HL), B

                ; переход ко второй строке и чтение её пикселей
                Direction? H
                POP BC

                ; вывод второй строки справа налево
                LD (HL), B
                DEC L
                LD (HL), C

                ; переход к следующей паре строк и чтение пикселей
                Direction? H
                POP BC
                endm
; -----------------------------------------
; рисование последних двух строк половины блока
; In:
;   HL - адрес левого байта первой строки
;   BC - пиксели первой строки, C = левый байт, B = правый
;   SP - адрес следующей пары байтов в буфере
;   Direction? - INC для движения вниз, DEC для движения вверх
; Out:
;   HL - адрес левого байта последней строки
;   BC - атрибуты половины блока
; Corrupt:
;   AF
; -----------------------------------------
FB_DRAW_PAIR_   macro Direction?
                ; вывод первой строки слева направо
                LD (HL), C
                INC L
                LD (HL), B

                ; переход ко второй строке и чтение её пикселей
                Direction? H
                POP BC

                ; вывод второй строки справа налево
                LD (HL), B
                DEC L
                LD (HL), C

                ; чтение атрибутов половины блока
                POP BC
                endm
; -----------------------------------------
; рисование половины блока 16x8 с атрибутами
; In:
;   HL - адрес левого байта первой строки вывода
;   DE - адрес данных половины блока, 18 байт
;   Direction? - INC для верхней половины, DEC для нижней
; Out:
;   HL - адрес левого атрибута нарисованной половины
; Corrupt:
;   DE, BC, AF
; Note:
;   границы экрана и трафарет проверяются перед вызовом
;   верхняя половина выводится сверху вниз, нижняя снизу вверх
;   исходный SP восстанавливается
; -----------------------------------------
FB_DRAW_HALF    macro Direction?
                ; подготовка восстановления данных при прерывании
                RESTORE_BC

                ; сохранение рабочего стека
                LD (.ContainerSP), SP

                ; чтение первой пары до переключения стека на буфер
                EX DE, HL
                LD C, (HL)
                INC HL
                LD B, (HL)
                INC HL
                LD SP, HL
                EX DE, HL

                ; вывод восьми строк и чтение атрибутов
                FB_DRAW_PAIR Direction?
                FB_DRAW_PAIR Direction?
                FB_DRAW_PAIR Direction?
                FB_DRAW_PAIR_ Direction?

                ; преобразование пиксельного адреса в атрибутный
                FB_TO_ATTR

                ; вывод левого и правого атрибутов
                LD (HL), C
                INC L
                LD (HL), B
                DEC L

                ; восстановление рабочего стека
.ContainerSP    EQU $+1
                LD SP, #0000
                endm

                endif ; ~_VFX_CROSSFADE_FALLING_BLOCKS_MACRO_
