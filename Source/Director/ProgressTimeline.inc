
                ifndef _AI_DIRECTOR_PROGRESS_TIMELINE_
                define _AI_DIRECTOR_PROGRESS_TIMELINE_
; -----------------------------------------
; временная шкала прогресса директора
;
; значения задаются в процентах общего прогресса загрузки сессии
;
; диапазоны этапов:
;   0.0–5.0   — инициализация карты расстояний
;   5.0–20.0  — волновое формирование карты расстояний
;   20.0–70.0 — поиск мест для точек спавна
;   70.0–80.0 — формирование списка точек спавна
;
; оставшийся диапазон 80.0–100.0 принадлежит этапам загрузки сессии
; и не управляется директором
; -----------------------------------------

                ; инициализация обрабатывает Size.Hextile = #0900 байт
                ; шаг выполняется после каждого блока из 256 гексагонов
                ; количество шагов равно 9
                ; 5.0 / 9 = 0.5556
                ; шаг после обработки 256 гексагонов
                define DIRECTOR_PROGRESS_DISTANCE_INITIALIZE_STEP 0.5556

                ; порог завершения инициализации карты расстояний
                ; устраняет погрешность накопления девяти шагов
                define DIRECTOR_PROGRESS_DISTANCE_INITIALIZE_END 5.0

                ; волновая функция выполняет не более 15 полных проходов
                ; первые 14 проходов распространяют конечные расстояния 1–14
                ; последний проход подтверждает отсутствие изменений
                ; фактическое количество проходов может быть меньше 15
                ; (20.0 - 5.0) / 15 = 1.0
                ; шаг после полного волнового прохода
                define DIRECTOR_PROGRESS_DISTANCE_BUILD_STEP 1.0

                ; порог завершения карты расстояний
                ; доводит прогресс до точного значения при досрочном завершении волны
                define DIRECTOR_PROGRESS_DISTANCE_BUILD_END 20.0

                ; порог завершения поиска мест для точек спавна
                define DIRECTOR_PROGRESS_LOCATION_SEARCH_END 70.0

                ; порог завершения работы директора
                define DIRECTOR_PROGRESS_END 80.0

                endif ; ~_AI_DIRECTOR_PROGRESS_TIMELINE_
