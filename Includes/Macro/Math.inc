
                ifndef _MACRO_MATH_
                define _MACRO_MATH_
; -----------------------------------------
; деление целого числа с округлением вверх
; In:
;   Value?   - неотрицательное делимое
;   Divisor? - положительный делитель
;   Label?   - метка результата
; Out:
;   Label? - результат деления с округлением вверх
; Note:
;   локальная метка результата передаётся в виде @.Label
; -----------------------------------------
DIV_ROUND_UP    macro Value?, Divisor?, Label?
Label?          = ((Value?) + (Divisor?) - 1) / (Divisor?)
                endm
; -----------------------------------------
; округление целого числа вверх до ближайшей степени двойки
; In:
;   Value? - неотрицательное целое число
;   Label? - метка результата
; Out:
;   Label? - ближайшая степень двойки, не меньшая Value?
; Note:
;   для нуля результат равен единице
;   локальная метка результата передаётся в виде @.Label
; -----------------------------------------
ROUND_UP_TO_POWER_OF_TWO macro Value?, Label?
                ; заполнение младших битов до старшего установленного бита
.Value          = (Value?) - 1
.Value          = .Value | (.Value >>> 1)
.Value          = .Value | (.Value >>> 2)
.Value          = .Value | (.Value >>> 4)
.Value          = .Value | (.Value >>> 8)
.Value          = .Value | (.Value >>> 16)

                ; расчёт следующей степени двойки
Label?          = .Value + 1

                ; проверка округления нулевого значения
                if (Value?) == 0
Label?          = 1
                endif
                endm

                endif ; ~_MACRO_MATH_
