                endm
; -----------------------------------------
; копирование строки слева направо, с переходом вниз
; In:
;   HL - адрес первого байта источника
;   DE - адрес первого байта назначения
;   BC - исходное значение счётчика LDI или LDD
;   NumByte? - количество байтов, не меньше 1
; Out:
;   HL, DE - адреса последнего байта следующей пиксельной строки
;   BC - исходное значение - (NumByte? - 1)
; Corrupt:
;   AF
; Note:
;   Исходная и целевая строки должны помещаться в строках экрана.
; -----------------------------------------
MEMCPY_BYTES    macro NumByte?
                rept (NumByte?)-1
                LDI
                endr
                LD A, (HL)
                LD (DE), A
                INC H
                INC D
                endm
; -----------------------------------------
; копирование строки слева направо, завершающее
; In:
;   HL - адрес первого байта источника
;   DE - адрес первого байта назначения
;   BC - исходное значение счётчика LDI или LDD
;   NumByte? - количество байтов, не меньше 1
; Out:
;   HL, DE - адреса после скопированной строки
;   BC - исходное значение - NumByte?
; Corrupt:
;   AF
; Note:
;   Исходная и целевая строки должны помещаться в строках экрана.
; -----------------------------------------
MEMCPY_BYTES_   macro NumByte?
                rept (NumByte?)
                LDI
                endr
                endm
; -----------------------------------------
; копирование строки справа налево, с переходом вниз
; In:
;   HL - адрес первого байта источника
;   DE - адрес первого байта назначения
;   BC - исходное значение счётчика LDI или LDD
;   NumByte? - количество байтов, не меньше 1
; Out:
;   HL, DE - адреса последнего байта следующей пиксельной строки
;   BC - исходное значение - (NumByte? - 1)
; Corrupt:
;   AF
; Note:
;   Исходная и целевая строки должны помещаться в строках экрана.
; -----------------------------------------
MEMCPY_BYTES_R  macro NumByte?
                rept (NumByte?)-1
                LDD
                endr
                LD A, (HL)
                LD (DE), A
                INC H
                INC D
                endm
; -----------------------------------------
; копирование строки справа налево, завершающее
; In:
;   HL - адрес первого байта источника
;   DE - адрес первого байта назначения
;   BC - исходное значение счётчика LDI или LDD
;   NumByte? - количество байтов, не меньше 1
; Out:
;   HL, DE - адреса последнего байта
;   BC - исходное значение - (NumByte? - 1)
; Corrupt:
;   AF
; Note:
;   Исходная и целевая строки должны помещаться в строках экрана.
; -----------------------------------------
MEMCPY_BYTES_R_ macro NumByte?
                rept (NumByte?)-1
                LDD
                endr
                LD A, (HL)
                LD (DE), A
                endm
; -----------------------------------------
; чтение 6 байт пиксельной строки стеком, с переходом вниз
; In:
;   HL - адрес начала строки источника
;   HL' - адрес, с которым продолжается внешний цикл после EXX
; Out:
;   SP - адрес источника + 6
; Corrupt:
;   HL, DE, BC, AF, HL', DE', BC', AF'
; Note:
;   EXX переключает рабочий набор регистров.
;   Прочитанные пары остаются в DE', BC', AF'.
;   Перед EXX адрес в HL сдвигается на следующую пиксельную строку.
; -----------------------------------------
POP_LINE_6      macro
                LD SP, HL
                INC H
                POP DE
                POP BC
                POP AF
                EX AF, AF'
                EXX
                endm
; -----------------------------------------
; чтение 4 байт пиксельной строки стеком, с переходом вниз
; In:
;   HL - адрес начала строки источника
;   HL' - адрес, с которым продолжается внешний цикл после EXX
; Out:
;   SP - адрес источника + 4
; Corrupt:
;   HL, DE, BC, HL', DE', BC'
; Note:
;   EXX переключает рабочий набор регистров.
;   Прочитанные пары остаются в DE', BC'.
;   Перед EXX адрес в HL сдвигается на следующую пиксельную строку.
; -----------------------------------------
POP_LINE_4      macro
                LD SP, HL
                INC H
                POP DE
                POP BC
                EXX
                endm
; -----------------------------------------
; чтение 6 байт пиксельной строки стеком
