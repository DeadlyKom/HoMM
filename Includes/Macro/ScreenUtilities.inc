
                ifndef _MACRO_SCREEN_UTILITIES_
                define _MACRO_SCREEN_UTILITIES_
; -----------------------------------------
; преобразование пиксельного адреса в атрибутный с сохранением DE
; In:
;   HL - адрес пикселей основного или теневого экрана
; Out:
;   HL - адрес соответствующего знакоместа атрибутов
; Corrupt:
;   AF
; Note:
;   Используется подготовленная таблица Adr.ScrAttrAdrTable.
; -----------------------------------------
HL_TO_ATTR_HL   macro
                LD A, L
                LD L, H
                LD H, HIGH Adr.ScrAttrAdrTable
                LD H, (HL)
                LD L, A
                endm
; -----------------------------------------
; преобразование пиксельного адреса в атрибутный с сохранением исходного адреса
; In:
;   HL - адрес пикселей основного или теневого экрана
; Out:
;   HL - адрес соответствующего знакоместа атрибутов
;   DE - исходный пиксельный адрес
; Note:
;   Используется подготовленная таблица Adr.ScrAttrAdrTable.
;   AF сохраняется.
; -----------------------------------------
HL_TO_ATTR_HL_SAVE_SCREEN macro
                EX DE, HL
                LD L, D
                LD H, HIGH Adr.ScrAttrAdrTable
                LD H, (HL)
                LD L, E
                endm
; -----------------------------------------
; переход к следующей строке пикселей
; In:
;   HL - текущий пиксельный адрес
; Out:
;   HL - адрес той же позиции в следующей строке
; Corrupt:
;   AF
; Note:
;   Переход не проверяет выход за границы экрана.
; -----------------------------------------
DOWN_HL         macro
                INC H
                LD A, L
                SUB #E0
                LD L, A
                SBC A, A
                AND #F8
                ADD A, H
                LD H, A
                endm
; -----------------------------------------
; переход к предыдущей строке пикселей
; In:
;   HL - текущий пиксельный адрес
; Out:
;   HL - адрес той же позиции в предыдущей строке
; Corrupt:
;   AF
; Note:
;   Переход не проверяет выход за границы экрана.
; -----------------------------------------
PIXEL_UP_HL     macro
                DEC H
                LD A, L
                ADD A, #E0
                LD L, A
                SBC A, A
                AND #08
                ADD A, H
                LD H, A
                endm
; -----------------------------------------
; переход к следующей строке пикселей
; In:
;   DE - текущий пиксельный адрес
; Out:
;   DE - адрес той же позиции в следующей строке
; Corrupt:
;   AF
; Note:
;   Переход не проверяет выход за границы экрана.
; -----------------------------------------
PIXEL_DOWN_DE   macro
                INC D
                LD A, E
                SUB #E0
                LD E, A
                SBC A, A
                AND #F8
                ADD A, D
                LD D, A
                endm
; -----------------------------------------
; переход к предыдущей строке пикселей
; In:
;   DE - текущий пиксельный адрес
; Out:
;   DE - адрес той же позиции в предыдущей строке
; Corrupt:
;   AF
; Note:
;   Переход не проверяет выход за границы экрана.
; -----------------------------------------
PIXEL_UP_DE     macro
                DEC D
                LD A, E
                ADD A, #E0
                LD E, A
                SBC A, A
                AND #08
                ADD A, D
                LD D, A
                endm
; -----------------------------------------
; переход к предыдущей строке атрибутов
; In:
;   DE - текущий атрибутный адрес
; Out:
;   DE - адрес той же позиции в предыдущей строке
; Corrupt:
;   AF
; Note:
;   Переход не проверяет выход за границы экрана.
; -----------------------------------------
ATTR_UP_DE      macro
                LD A, E
                SUB #20
                LD E, A
                SBC A, A
                ADD A, D
                LD D, A
                endm
; -----------------------------------------
; чтение пары байтов слева направо в стек
; In:
;   HL - адрес первого байта пары
;   SP - указатель стека буфера
; Out:
;   HL - исходный адрес + 2
;   SP - исходный указатель - 2
; Corrupt:
;   BC
; Note:
;   В паре C хранит первый прочитанный байт, B хранит второй.
;   Пара должна целиком помещаться в строке экрана.
; -----------------------------------------
READ_TWO_BYTES_FORWARD macro
                LD C, (HL)
                INC L
                LD B, (HL)
                INC L
                PUSH BC
                endm
; -----------------------------------------
; чтение пары байтов слева направо в стек, завершающее
; In:
;   HL - адрес первого байта пары
;   SP - указатель стека буфера
; Out:
;   HL - исходный адрес + 1
;   SP - исходный указатель - 2
; Corrupt:
;   BC
; Note:
;   В паре C хранит первый прочитанный байт, B хранит второй.
;   Пара должна целиком помещаться в строке экрана.
; -----------------------------------------
READ_TWO_BYTES_FORWARD_ macro
                LD C, (HL)
                INC L
                LD B, (HL)
                PUSH BC
                endm
; -----------------------------------------
; чтение пары байтов справа налево в стек
; In:
;   HL - адрес первого байта пары
;   SP - указатель стека буфера
; Out:
;   HL - исходный адрес - 2
;   SP - исходный указатель - 2
; Corrupt:
;   BC
; Note:
;   В паре C хранит первый прочитанный байт, B хранит второй.
;   Пара должна целиком помещаться в строке экрана.
; -----------------------------------------
READ_TWO_BYTES_BACKWARD macro
                LD C, (HL)
                DEC L
                LD B, (HL)
                DEC L
                PUSH BC
                endm
; -----------------------------------------
; чтение пары байтов справа налево в стек, завершающее
; In:
;   HL - адрес первого байта пары
;   SP - указатель стека буфера
; Out:
;   HL - исходный адрес - 1
;   SP - исходный указатель - 2
; Corrupt:
;   BC
; Note:
;   В паре C хранит первый прочитанный байт, B хранит второй.
;   Пара должна целиком помещаться в строке экрана.
; -----------------------------------------
READ_TWO_BYTES_BACKWARD_ macro
                LD C, (HL)
                DEC L
                LD B, (HL)
                PUSH BC
                endm
; -----------------------------------------
; запись пары байтов из стека слева направо
; In:
;   HL - адрес первого байта назначения
;   SP - указатель стека сохранённых данных
; Out:
;   HL - исходный адрес + 2
;   SP - исходный указатель + 2
; Corrupt:
;   BC
; Note:
;   Сначала записывается B, затем C, в порядке обратном сохранению.
;   Пара должна целиком помещаться в строке экрана.
; -----------------------------------------
WRITE_TWO_BYTES_FORWARD macro
                POP BC
                LD (HL), B
                INC L
                LD (HL), C
                INC L
                endm
; -----------------------------------------
; запись пары байтов из стека слева направо, завершающая
; In:
;   HL - адрес первого байта назначения
;   SP - указатель стека сохранённых данных
; Out:
