
                ifndef _STRUCTS_INVENTORY_SLOTS_STATES_
                define _STRUCTS_INVENTORY_SLOTS_STATES_

                struct FInventorySlotStates                                     ; состояние ячейки инвентаря                                   [13 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | BR | FO | SA |
;   +----+----+----+----+----+----+----+----+
;
;   SA      [0]     - флаг, активности слота
;   FO      [1]     - флаг, исчезновения слота, 0 - появление, 1 - исчезновение
;   BR      [2]     - флаг, готовности обоих сохранённых буферов
; -----------------------------------------
Flags           DB #00                                                          ; флаги
Animation       DB #00                                                          ; текущее состояние анимации
Delay           DB #00                                                          ; задержка перед кадром анимации
AttributesAdr   DW #0000                                                        ; адрес буфера конечных атрибутов
BackgroundAdr   DW #0000                                                        ; адрес буфера пикселей и атрибутов фона
Location        DW #0000                                                        ; позиция сохраняемой области в знакоместах, старший байт Y, младший X
Size            DW #0000                                                        ; размер сохраняемой области в знакоместах, старший байт высота, младший ширина
SpriteAdr       DW #0000                                                        ; адрес составного спрайта рамки
                ends

                endif ; ~_STRUCTS_INVENTORY_SLOTS_STATES_
