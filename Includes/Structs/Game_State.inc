
                ifndef _STRUCTS_GAME_STATE_
                define _STRUCTS_GAME_STATE_

                struct FGameState                                               ; переменные состояния игры                                     [57 байт] / 64
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | UP | EX | EN | TR |
;   +----+----+----+----+----+----+----+----+
;
;   UP      [3]     - флаг, обновления
;   EX      [2]     - флаг, завершения цикла
;   EN      [1]     - флаг, первичного запуска (необходимо для инициализации)
;   TR      [1]     - флаг, переход между циклами
; -----------------------------------------
MainLoop        DB #00                                                          ; флаги главного цикла                                          [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CH | NS | T1 | T0 | SF | SP | SW | FR |
;   +----+----+----+----+----+----+----+----+
;
;   CH      [7]     - флаг, скрытия курсора
;                       0 - курсор виден
;                       1 - курсор скрыт
;   NS      [6]     - флаг, отключения смены экранов
;   T1,T0   [5,4]   - выбор целевого экрана
;                       00 - переключение автоматическое
;                       01 - переключение только на базовый экран
;                       11 - переключение только на теневой экран
;   SF      [3]     - флаг, отключения отображения FPS
;   SP      [2]     - флаг, переключение выполнено, ожидается окончание прерывания
;   SW      [1]     - флаг, ожидания переключения экрана
;   FR      [0]     - флаг, готовности кадра
; -----------------------------------------
Render          DB #00                                                          ; флаги отрисовки                                               [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | EM |
;   +----+----+----+----+----+----+----+----+
;
;   FS      [0]     - флаг, разрешения проигрывания музыки
; -----------------------------------------
Music           DB #00                                                          ; флаги отрисовки                                               [1 байт]
UIRuntime       FUIRuntime                                                      ; UI режим                                                      [7 байт]
TickRuntime     FTickRuntime                                                    ; управление тиком                                              [2 байта]
DisplayList     DW #0000                                                        ; адрес список отображения                                      [2 байта]
DisplayListLen  DB #00                                                          ; длина список отображения                                      [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | GT |
;   +----+----+----+----+----+----+----+----+
;
;   GT      [0]     - флаг, отключение глобального тика
; -----------------------------------------
Interrupt       DB #00                                                          ; флаги прерывания                                              [1 байт]
Screen          DB #00                                                          ; старший бит адрес экрана                                      [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | TX | PC | RS | SO | .. | DD | SS | CS |
;   +----+----+----+----+----+----+----+----+
;
;   TX      [7]     - флаг, режим ввода текста
;   PC      [6]     - флаг, отсутствия действий нажатия/отжатия клавиши
;   RS      [5]     - флаг, клавиша нажата/отжата
;   SO      [4]     - флаг, отключния сканирования
;   DD      [2]     - флаг, активности перетаскивания
;                       0 - перетаскивание неактивно
;                       1 - перетаскивание активно
;   SS      [1]     - флаг, зажат Symbol Shift
;   CS      [0]     - флаг, зажат Caps Shift
; -----------------------------------------
Input           DB #00                                                          ; флаги ввода                                                   [1 байт]
Input.VK        DB #00                                                          ; номер "виртуальной" клавишаи                                  [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | MP | ES | SC | AC |  L |  R | U |  D |
;   +----+----+----+----+----+----+----+----+
;
;   MP      [7]     - флаг, нажатия клавиши "меню/пауза"
;   ES      [6]     - флаг, нажатия клавиши "выход"
;   SC      [5]     - флаг, нажатия клавиши "выбор"
;   AC      [4]     - флаг, нажатия клавиши "ускорить"
;   L       [3]     - флаг, нажатия клавиши влево
;   R       [2]     - флаг, нажатия клавиши вправо
;   U       [1]     - флаг, нажатия клавиши вверх
;   D       [0]     - флаг, нажатия клавиши вниз
; -----------------------------------------
Input.Value     DB #00                                                          ; дополнительный флаг                                           [1 байт]
; -----------------------------------------
;
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | CK | FI | L2 | L1 | L0 | C2 | C1 | C0 |
;   +----+----+----+----+----+----+----+----+
;
;   CK      [7]     - флаг, смены нажатия клавиши
;   FI      [6]     - флаг, инициализации (первичное отображение слотов)
;   L2-C0   [5-3]   - номер предыдущей нажатой клавиши
;   C2-C0   [2-0]   - номер текущей нажатой клавиши
; -----------------------------------------
Input.HotKeys   DB #00                                                          ; флаг ввода горячих клавиш                                     [1 байт]
; -----------------------------------------
;
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | ST |
;   +----+----+----+----+----+----+----+----+
;
;   ST      [0]     - флаг, разрешения обновления скрола карты 
; -----------------------------------------
Input.Timer     DB #00                                                          ; флаги таймера ввода                                           [1 байт]
; -----------------------------------------
;
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | TB | RB | .. | CE | MP | FF | P1 | P0 |
;   +----+----+----+----+----+----+----+----+
;
;   TB      [7]     - флаг, необходимости обновить TilemapBuffer
;   RB      [6]     - флаг, необходимости обновить RenderBuffer
;   CE      [4]     - флаг, разрешения вызова формирования обводки
;   MP      [3]     - флаг, установки положения карты по мини-карте
;   FF      [2]     - флаг, принудительного обновления кадра
;   P1,P0   [1,0]   - фаза обводки
;                       00 - радиус 1 пиксель
;                       01 - радиус 2 пикселя
;                       10 - радиус 3 пикселя
; -----------------------------------------
View            DB #00                                                          ; флаги вида                                                    [1 байт]
PlayerActions   FPlayerActions                                                  ; действия игрока                                               [? байт]
Inventory       FShortLinearAddress                                             ; расположение блока предметов и их размещения                  [2 байта]
ItemsNum        DB #00                                                          ; количество предметов в массиве                                [1 байт]
AssetID         DB #00                                                          ; идентификатор последнего загруженного ресурса                 [1 байт]
Assets          FAssets                                                         ; копия данных последнего загруженного ресурса                  [8 байт]
FontSize        FSize                                                           ; размер выводимого символа                                     [2 байта]
SpriteInfoNum   DB #00                                                          ; количество спрайтов в массиве SpriteInfoBuffer                [1 байт]
SpriteBound     FSpriteBound                                                    ; bound спрайта после его отрисовки на экране                   [4 байт]
LeftEdge        DB #00                                                          ; левая грань видимой части     (в пикселах)                    [1 байт]
VisibleWidth    DB #00                                                          ; ширина видимой части          (в знакоместах)                 [1 байт]
TopEdge         DB #00                                                          ; верхняя грань видимой части   (в пикселах)                    [1 байт]
VisibleHeight   DB #00                                                          ; высота видимой части          (в пикселах)                    [1 байт]
TickCounter     FTick                                                           ; счётчик тиков                                                 [4 байта]
Cursor          FCursorState                                                    ; состояние курсора                                             [6 байт]
                ends

                endif ; ~_STRUCTS_GAME_STATE_
