
                ifndef _STRUCTS_FONT_
                define _STRUCTS_FONT_

                struct FFont                                                    ; описание шрифта                                                   [4 байта]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | LU1| LU0| LL1| LL0| RU1| RU0| RL1| RL0|
;   +----+----+----+----+----+----+----+----+
;
;   LU1,LU0 [7,6]       - флаг, глубина левой-верхней части
;   LL1,LL0 [5,4]       - флаг, глубина левой-нижней части
;   RU1,RU0 [3,2]       - флаг, глубина правой-верхней части
;   RL1,RL0 [1,0]       - флаг, глубина правой-нижней части
;
;   значения:
;       0       - отсутствует глубина
;       1..2    - доступная глубина перекрытия
; -----------------------------------------
Height          DB #00                                                          ; высота спрайта                                                    [1 байта]
SpacingProfile  DB #00                                                          ; кернинг допустимой глубины перекрытия                             [1 байта]
Advance         DB #00                                                          ; насколько сдвинуть курсор после буквы (ширина буквы + пиксель)    [1 байта]
Baseline        DB #00                                                          ; базовая линия глифа                                               [1 байта]
                                                                                ; необходима, чтобы буквы разной высоты располагались
                                                                                ; правильно относительно одной строки
Sprite                                                                          ; данные спрайта
                                                                                ; OR+XOR не могут быть нулевыми,
                                                                                ; что говорит об отсутствии данных спрайта
                ends

                endif ; ~_STRUCTS_FONT_
