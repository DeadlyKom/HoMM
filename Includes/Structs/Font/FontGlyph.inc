
                ifndef _STRUCTS_FONT_GLYPH_
                define _STRUCTS_FONT_GLYPH_

                struct FFontGlyph                                               ; описание глифа шрифта                                             [4 байта]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | LU1| LU0| LL1| LL0| RU1| RU0| RL1| RL0|
;   +----+----+----+----+----+----+----+----+
;
;   LU1,LU0 [7,6]       - свободная глубина левой верхней части
;   LL1,LL0 [5,4]       - свободная глубина левой нижней части
;   RU1,RU0 [3,2]       - свободная глубина правой верхней части
;   RL1,RL0 [1,0]       - свободная глубина правой нижней части
;
;   значения:
;       0       - свободная глубина отсутствует
;       1..3    - свободная глубина края глифа в пикселях
; -----------------------------------------
Height          DB #00                                                          ; высота спрайта                                                    [1 байт]
Width           DB #00                                                          ; ширина спрайта                                                    [1 байт]
SpacingProfile  DB #00                                                          ; профиль свободной глубины краёв глифа                             [1 байт]
Baseline        DB #00                                                          ; базовая линия шрифта                                              [1 байт]
                                                                                ; необходима, чтобы глифы разной высоты располагались
                                                                                ; правильно относительно одной строки
Sprite                                                                          ; данные спрайта
                                                                                ; нулевая высота обозначает отсутствие данных спрайта
                ends

                endif ; ~_STRUCTS_FONT_GLYPH_
