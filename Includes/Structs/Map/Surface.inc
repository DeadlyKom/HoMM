
                ifndef _STRUCT_MAP_SURFACE_
                define _STRUCT_MAP_SURFACE_
; -----------------------------------------
; ℹ️ Логическое представление
; В памяти таблица хранится в следующем формате:
;   Passability[256] по Adr.SurfPassability
;   Property[256]    по Adr.SurfProperty
;
;   ⚠️ ВАЖНО ⚠️
; Поля структуры FMapSurface нельзя использовать
; как физические смещения внутри таблицы
; -----------------------------------------
                struct FMapSurface                                              ; структура, описывающая свойства типа гексагона
; -----------------------------------------
;   +----+----+----+----+----+----+----+----+
;   |  7 |  6 |  5 |  4 |  3 |  2 |  1 |  0 |
;   +----+----+----+----+----+----+----+----+
;   | T2 | T1 | T0 | C4 | C3 | C2 | C1 | C0 |
;   +----+----+----+----+----+----+----+----+
;
;   T2-T0   [7..5]  - тип поверхности
;                       000 - обычная
;                       110 - дорога
;                       111 - поселение
;   C4-C0   [4..0]  - стоимость перемещения по поверхности
; -----------------------------------------
Passability     DB #00                                                          ; логический младший байт: проходимость
; -----------------------------------------
;   +----+----+----+----+----+----+----+----+
;   |  7 |  6 |  5 |  4 |  3 |  2 |  1 |  0 |
;   +----+----+----+----+----+----+----+----+
;   | R2 | R1 | R0 | .. | .. | .. | .. | .. |
;   +----+----+----+----+----+----+----+----+
;
;   R2-R0   [7..5]  - модификатор разведки
;                       110 - модификатор  -2
;                       111 - модификатор  -1
;                       000 - без изменения
;                       001 - модификатор  +1
;                       010 - модификатор  +2
;                       011 - модификатор  +3
; -----------------------------------------
Property        DB #00                                                          ; логический старший байт: свойство
                ends

                endif ; ~_STRUCT_MAP_SURFACE_
