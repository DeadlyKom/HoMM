                ifndef _STRUCT_RAIN_
                define _STRUCT_RAIN_

                struct FRainDrop
X               DB #00                                                          ; экранная координата точки появления по горизонтали
Y               DB #00                                                          ; экранная координата точки появления по вертикали
Phase           DB #08                                                          ; фаза, 0..5 падение, 6..7 всплеск, 8 новое появление
Shown           DB #00                                                          ; признак рисунка на экране, 0 отсутствует, 1 нарисован
FallFrac        DB #00                                                          ; дробный накопитель продвижения фазы падения с делителем 256
                ends

                endif                                                           ; ~_STRUCT_RAIN_
