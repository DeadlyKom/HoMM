                ifndef _STRUCT_SNOW_
                define _STRUCT_SNOW_
                struct FSnowFlake
Fraction        FVector8                                                        ; дробные части свободной позиции, доли с делителем 256
Velocity        FVector8                                                        ; знаковая скорость по осям, доли пикселя с делителем 16
Shape           DB 0                                                            ; форма, 0 точка, 1 плюсик, 2 квадрат
Position        FVector8                                                        ; координаты последнего рисунка в пикселях
                ; биты Shown от 7 до 0
                ; 7, флаг, форма нарисована на обоих экранах
                ; 6, флаг, форма пересекает границу двух строк блоков
                ; 5..4, номер первой строки блоков, 0..3
                ; 3..0, маска пересекаемых столбцов блоков
                ; нулевое состояние, форма ещё не создана и не нарисована
Shown           DB 0                                                            ; наличие рисунка и кеш пересекаемых блоков
                ends
                endif ; ~_STRUCT_SNOW_
