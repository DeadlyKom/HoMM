
                ifndef _STRUCT_LAYER_OBJECT_
                define _STRUCT_LAYER_OBJECT_

                struct FLayerObject                                             ; промежуточный класс объектов Decal и UI                   [17 байт]
Super           FObject                                                         ; базовый класс объекта                                     [14 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | AN | XO | YO | AA |
;   +----+----+----+----+----+----+----+----+
;
;   AN      [3]     - флаг, разрешающий анимацию объекта
;                       0 - анимация выключена
;                       1 - анимация включена
;   XO      [2]     - операция со смещением AxisOffset.X
;                       0 - прибавить к экранной позиции
;                       1 - вычесть из экранной позиции
;   YO      [1]     - операция со смещением AxisOffset.Y
;                       0 - прибавить к экранной позиции
;                       1 - вычесть из экранной позиции
;   AA      [0]     - флаг, выравнивать положение объекта по знакоместу
;                       0 - не выравнивается
;                       1 - выравнивается, необходим для спрайтов с атрибутами
; -----------------------------------------
Flags           DB #00                                                          ; флаги                                                     [1 байт]
AxisOffset      FVector8                                                        ; дополнительные смещения осей относительно объекта         [2 байт]
                                                                                ; позволяет управолять положением без анкерного объекта
                ends

                endif ; ~_STRUCT_LAYER_OBJECT_
