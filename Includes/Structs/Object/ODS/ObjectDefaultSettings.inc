
                ifndef _STRUCT_OBJECT_DEFAULT_SETTINGS_
                define _STRUCT_OBJECT_DEFAULT_SETTINGS_

                struct FObjectDefaultSettings                                   ; настройки объекта по умолчанию                            [8 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | V3 | V2 | V1 | V0 | C3 | C2 | C1 | C0 |
;   +----+----+----+----+----+----+----+----+
;
;   V3-V0   [7..4]  - визуальный тип (смещение индексов)
;   C3-C0   [3..0]  - класс объекта
; -----------------------------------------
Class           DB #00                                                          ; класс                             (0)                     [1 байт]        
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | AF | .. | .. | .. | .. | .. | .. | .. |
;   +----+----+----+----+----+----+----+----+
;
;   AF      [7]     - принадлежность
;                       0 - объект не может кому либо принадлежать
;                       1 - объект может принадлежать кому либо из игроков
; -----------------------------------------
Flags           DB #00                                                          ; флаги                                                     [1 байт]
Variable_A      DB #00                                                          ; переменная А                                              [1 байт]
Variable_B      DB #00                                                          ; переменная Б                                              [1 байт]

Dummy                                                                           ; резерв                                                    [4 байт]
                ends

                endif ; ~_STRUCT_OBJECT_DEFAULT_SETTINGS_
