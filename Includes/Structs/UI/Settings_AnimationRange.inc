
                ifndef _STRUCTS_UI_SETTINGS_ANIMATION_RANGE_
                define _STRUCTS_UI_SETTINGS_ANIMATION_RANGE_

                struct FUISettings_AnimationRange                               ; настройки диапазона анимации UI объекта                   [2 байта]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | F3 | F2 | F1 | F0 | R3 | R2 | R1 | R0 |
;   +----+----+----+----+----+----+----+----+
;
;   F3-F0   [7..4]  - индекс первого кадра диапазона
;   R3-R0   [3..0]  - количество кадров в диапазоне
;
;   - диапазон должен находиться внутри FSpritesRef
;   - индекс последнего кадра диапазона должен быть меньше FSpritesRef.Num
; -----------------------------------------
Range           DB #00                                                          ; диапазон кадров анимации                                  [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | PP | RV | .. | .. | .. | .. |
;   +----+----+----+----+----+----+----+----+
;
;   PP      [5]     - флаг, пинг-понга
;                       0 - выключен
;                       1 - включён
;   RV      [4]     - флаг, направления проигрывания анимации
;                       0 - прямое
;                       1 - обратное
; -----------------------------------------
Mode            DB #00                                                          ; режим проигрывания анимации                               [1 байт]
                ends

                endif ; ~_STRUCTS_UI_SETTINGS_ANIMATION_RANGE_
