
                ifndef _STRUCTS_UI_BEHAVIOR_PHASE_
                define _STRUCTS_UI_BEHAVIOR_PHASE_

                struct FUIBehaviorPhase                                         ; фаза поведения UI объекта                                 [4 байта]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | F7 | F6 | F5 | F4 | F3 | F2 | F1 | F0 |
;   +----+----+----+----+----+----+----+----+
;
;   F7-F0   [7..0]  - индекс функции фазы в таблице обработчиков
; -----------------------------------------
Function        DB #00                                                          ; функция фазы                                              [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | ST | LP |
;   +----+----+----+----+----+----+----+----+
;
;   ST      [1]     - флаг, остановки дальнейшего выполнения текущего тика
;                       0 - продолжить выполнение со следующей фазы
;                       1 - остановить выполнение цепочки до следующего тика
;   LP      [0]     - флаг, повтора фазы после её завершения
;                       0 - перейти к следующей фазе
;                       1 - после завершения запустить текущую фазу заново
;                     применяется при установленном флаге переполнения после выполнения функции фазы
; -----------------------------------------
Flags           DB #00                                                          ; управление выполнением фазы                               [1 байт]
Settings        DW #0000                                                        ; адрес настроек функции фазы                               [2 байта]
                                                                                ; #0000 - функция не использует дополнительные настройки
                ends

                endif ; ~_STRUCTS_UI_BEHAVIOR_PHASE_
