
                ifndef _STRUCTS_ITEM_
                define _STRUCTS_ITEM_
; -----------------------------------------
;   экземпляр предмета, созданный в рантайме
;   выбранные аффиксы сохраняются по индексам
;   полученные значения свойств записываются по порядку аффиксов и их блоков
;   базовые свойства не изменяются, доступны через индекс BaseItem
; -----------------------------------------
                struct FItem                                                    ; экземпляр предмета                                    [6 + PropertiesNum * 4 байт]
BaseItem        DB #00                                                          ; индекс базового описания FBaseItem                    [1 байт]
Quality         DB #00                                                          ; качество экземпляра ITEM_QUALITY_                     [1 байт]
Prefix          DS 1, #00                                                       ; массив индексов выбранных префиксов                   [1 байта]
Suffix          DS 1, #00                                                       ; массив индексов выбранных суффиксов                   [1 байта]
State           DB #00                                                          ; состояние экземпляра предмета                         [1 байт]
PropertiesNum   DB #00                                                          ; количество свойств экземпляра                         [1 байт]
Properties                                                                      ; массив свойств FItemProperty в порядке генерации
                ends

                endif ; ~_STRUCTS_ITEM_
