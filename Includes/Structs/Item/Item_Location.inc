
                ifndef _STRUCTS_ITEM_LOCATION_
                define _STRUCTS_ITEM_LOCATION_
; -----------------------------------------
;   местонахождение экземпляра предмета
;   индекс записи совпадает с FItemID экземпляра в массиве FItem
; -----------------------------------------
                struct FItemLocation                                            ; местонахождение предмета                              [4 байта]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | IP | EQ |
;   +----+----+----+----+----+----+----+----+
;
;   IP      [1]     - флаг, пользовательская позиция элемента
;                       0 - предмет хранит позицию
;                       1 - пользовательская позиция элемента
;   EQ      [0]     - флаг, экипировки предмета
;                       0 - предмет не экипирован
;                       1 - предмет экипирован
; -----------------------------------------
State           DB #00                                                          ; состояние размещения предмета                         [1 байт]
; -----------------------------------------
;   первые N контейнеров соответствуют индексам персонажей 0..N-1
;   начиная с N располагаются сундуки и другие контейнеры
;   при экипировке сохраняется индекс контейнера персонажа
; -----------------------------------------
Container       DB #00                                                          ; индекс контейнера предмета                            [1 байт]
; -----------------------------------------
;   в сетке Position задаёт левый верхний угол предмета в ячейках
;   при экипировке Position содержит данные места экипировки
; -----------------------------------------
Position        FVector8                                                        ; позиция в сетке или данные места экипировки           [2 байта]
                ends

                endif ; ~_STRUCTS_ITEM_LOCATION_

