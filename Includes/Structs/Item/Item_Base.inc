
                ifndef _STRUCTS_ITEM_BASE_
                define _STRUCTS_ITEM_BASE_
; -----------------------------------------
;   заранее подготовленные данные, описывающие предмет
;   используется экземплярами предметов FItem
; -----------------------------------------
                struct FBaseItem                                                ; базовое описание предмета                             [10 + PropertiesNum * 4 байт]
Name            DB #00                                                          ; индекс текста названия предмета                       [2 байта]
Visual          DB #00                                                          ; индекс структуры FItemVisual                          [1 байт]
Type            DB #00                                                          ; тип предмета ITEM_TYPE_                               [1 байт]
; -----------------------------------------
;      7    6    5    4    3    2    1    0
;   +----+----+----+----+----+----+----+----+
;   | .. | .. | .. | .. | .. | .. | .. | AF |
;   +----+----+----+----+----+----+----+----+
;
;   AF      [0]         - флаг, разрешения дополнительных аффиксов
;                           0 - дополнительные аффиксы запрещены
;                           1 - дополнительные аффиксы разрешены
; -----------------------------------------
Flags           DB #00                                                          ; флаги базового предмета                               [1 байт]
Min             FValue                                                          ; минимальное значение для выборки                      [2 байта]
Max             FValue                                                          ; максимальное значение для выборки                     [2 байта]
PropertiesNum   DB #00                                                          ; количество свойств                                    [1 байт]
Properties                                                                      ; массив свойств FItemProperty
                ends

                endif ; ~_STRUCTS_ITEM_BASE_
