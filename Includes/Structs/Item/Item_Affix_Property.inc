
                ifndef _STRUCTS_ITEM_AFFIX_PROPERTY_
                define _STRUCTS_ITEM_AFFIX_PROPERTY_
; -----------------------------------------
;   правило генерации свойства аффикса
;   при одинаковых Min и Max величина свойства фиксированная
; -----------------------------------------
                struct FItemAffixProperty                                       ; правило генерации свойства                            [7 байт]
Type            DB #00                                                          ; тип создаваемого свойства ITEM_PROPERTY_              [1 байт]
; -----------------------------------------
;   Param определяет, к чему применяется свойство
;   для бонуса отдельному умению содержит номер этого умения
;   например, Type задаёт бонус умению, Param выбирает огненный шар,
;   Min и Max задают величину бонуса от 1 до 3
;   для свойств без дополнительного параметра задаётся 0
; -----------------------------------------
Param           DW #0000                                                        ; дополнительный параметр, назначение зависит от Type   [2 байта]
Min             FValue                                                          ; минимальная величина свойства                         [2 байта]
Max             FValue                                                          ; максимальная величина свойства                        [2 байта]
                ends

                endif ; ~_STRUCTS_ITEM_AFFIX_PROPERTY_
