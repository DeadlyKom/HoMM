                ifndef _STRUCT_TORNADO_
                define _STRUCT_TORNADO_
                struct FTornadoParticle
Position        FVector8                                                        ; позиция относительно камеры на момент запуска
BasePosition    FVector8                                                        ; снимок временной накладки основного экрана
Phase           DB 0                                                            ; фаза обращения, полный оборот равен 256
Height          DB 0                                                            ; высота подъёма в долях 1/4 пикселя
                ; биты Shown от 7 до 0
                ; 7, флаг, текущая форма нарисована в теневом экране
                ; 6, флаг, снимок формы нарисован в основном экране
                ; 5, флаг, головка 2 на 2, иначе точка 1 на 1
                ; 4..1, постоянный порог рассеивания, 0..15
                ; 0, флаг, частица существует в текущей истории
                ; нулевое состояние, частица отсутствует в обоих экранах
Shown           DB 0                                                            ; видимость по экранам, порог и существование
                ends
                assert FTornadoParticle == 7
                endif                                                           ; ~_STRUCT_TORNADO_
